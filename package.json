{
  "name": "battery-info-module",
  "version": "1.0.1",
  "private": true,
  "description": "KernelSU Next WebUI module that logs battery metrics over time.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node build.mjs",
    "zip": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"import('node:fs').then(fs=>{fs.rmSync('module/webroot',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true})})\""
  },
  "dependencies": {
    "kernelsu": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "archiver": "^8.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
